{
  "name": "nutrios-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite-react-ssg build",
    "preview": "vite preview",
    "lint": "oxlint && stylelint \"src/**/*.scss\" && tsx scripts/check-copy.ts",
